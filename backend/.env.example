# PMC 后端配置模板：复制为 .env 后按需修改（.env 已被 gitignore）
# 安全（生产必须修改）
# JWT_SECRET=please-change-this-secret
# INTERNAL_TOKEN=internal-pmc-token-change-me

# 数据库：默认 SQLite（本地零配置）；生产切换 Postgres：
# DATABASE_URL=postgresql+psycopg2://pmc:pmc_pass@127.0.0.1:5432/pmc

# 消息队列：本地开发关闭；生产开启并指向 RabbitMQ
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ENABLED=false

# 网关 -> 各微服务地址（本地开发用 127.0.0.1）
AUTH_SERVICE_URL=http://127.0.0.1:8001
PMC_SERVICE_URL=http://127.0.0.1:8002
WARNING_SERVICE_URL=http://127.0.0.1:8003
REPORT_SERVICE_URL=http://127.0.0.1:8004
